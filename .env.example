# Telegram
TELEGRAM_TOKEN=123456:ABC-your-bot-token

# Sirf in Telegram user IDs ke liye allow (comma separated). Khaali = sab allow.
# Apna ID @userinfobot se le lo.
ALLOWED_USERS=

# RDP (Windows machine)
RDP_HOST=1.2.3.4
RDP_PORT=3389
RDP_USER=Administrator
RDP_PASS=your-strong-password
